        { "type": "say", "character": "marshall", "to": "wendy", "line": "Forty minutes? What do they even talk about?", "emotion": "confused" },
        { "type": "pause", "seconds": 1.2 },
        { "type": "say", "character": "marshall", "line": "Oh. Oh!", "emotion": "surprised", "laugh": "laugh" },
        { "type": "say", "character": "lily", "to": "wendy", "line": "Wendy, how do you know all this?", "emotion": "confused" },
        { "type": "say", "character": "wendy", "to": "lily", "line": "I'm a waitress. People think I'm furniture. Furniture hears everything.", "emotion": "happy", "laugh": "chuckle" },
        { "type": "say", "character": "lily", "to": "barney", "line": "Okay. I'm going over there to ask nicely." },
        { "type": "say", "character": "barney", "to": "lily", "line": "Nicely? You?", "emotion": "confused" },
