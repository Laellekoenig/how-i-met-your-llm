        { "type": "say", "character": "ted", "to": "robin", "line": "I passed.", "delivery": "whisper", "emotion": "happy", "laugh": "laugh" },
        { "type": "say", "character": "guest2", "to": "guest1", "line": "Okay, gang. It's time to vest up!", "emotion": "excited", "gesture": "suit_up" },
