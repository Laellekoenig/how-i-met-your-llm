        { "type": "say", "character": "guest2", "to": "guest3", "line": "Tonight is gonna be legen, wait for it, dairy!", "emotion": "excited", "gesture": "hands_up" },
        { "type": "say", "character": "barney", "to": "guest2", "line": "You waited for it! You waited for it and you still got it wrong!", "delivery": "shout", "emotion": "angry", "laugh": "laugh" },
        { "type": "say", "character": "marshall", "to": "lily", "line": "Wait, I only count three. Where are the other two?", "emotion": "confused" },
