        { "type": "say", "character": "guest1", "to": "lily", "line": "Oh my gosh, that's adorable. No.", "emotion": "happy", "laugh": "laugh" },
        { "type": "say", "character": "lily", "to": "guest1", "line": "Excuse me?", "delivery": "shout", "emotion": "angry" },
