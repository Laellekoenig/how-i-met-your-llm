        { "type": "say", "character": "marshall", "to": "robin", "line": "A booth is just land with a cushion.", "laugh": "laugh" },
        { "type": "say", "character": "lily", "line": "Three nights. This means war.", "delivery": "slow", "emotion": "angry", "shot": "push_in" },
        { "type": "say", "character": "wendy", "to": "lily", "line": "Ooh, a war! I'll get nachos.", "emotion": "excited", "laugh": "laugh" }
      ]
