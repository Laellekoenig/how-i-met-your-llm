        { "type": "say", "character": "lily", "to": "guest1", "line": "Did you just inside-voice me? I teach kindergarten. I invented inside voice.", "emotion": "angry" },
        { "type": "say", "character": "guest1", "to": "lily", "line": "Kindergarten. Cute. I teach pre-K. Younger kids. Harder.", "emotion": "smug", "laugh": "laugh" },
        { "type": "say", "character": "guest1", "to": "lily", "line": "Anyway. You guys had a great run.", "emotion": "happy", "gesture": "wave", "laugh": "gasp" },
